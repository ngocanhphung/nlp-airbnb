        "reviews_clean = reviews.dropna(subset=['comments']).copy()\n",
        "reviews_clean['comments_lower'] = reviews_clean['comments'].str.lower()\n",
        "\n",
        "analyzer = SentimentIntensityAnalyzer()\n",
        "reviews_clean['compound'] = reviews_clean['comments'].apply(\n",
        "    lambda x: analyzer.polarity_scores(str(x))['compound']\n",
        ")\n",
        "\n",
        "# Define \"dissatisfied\" reviews: compound score <= -0.05 (VADER standard threshold)\n",
        "negative_reviews = reviews_clean[reviews_clean['compound'] <= -0.05].copy()\n",
        "print(f\"Total reviews: {len(reviews_clean)}\")\n",
        "print(f\"Negative reviews (compound ≤ -0.05): {len(negative_reviews)} ({len(negative_reviews)/len(reviews_clean)*100:.1f}%)\")"
      ]
