        "        tokens = [w for w in tokens if len(w) > 3]\n",
        "        # Remove stop words\n",
        "        tokens = [w for w in tokens if w not in stop_words]\n",
        "        return ' '.join(tokens)\n",
        "    except:\n",
        "        return ''\n",
