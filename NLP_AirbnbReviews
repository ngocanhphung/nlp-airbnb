        "    all_count = reviews_clean['aspects'].apply(lambda x: aspect in x).sum()\n",
        "    neg_count = negative_reviews['aspects'].apply(lambda x: aspect in x).sum()\n",
        "\n",
        "    pct_all = all_count / total * 100\n",
        "    pct_neg = neg_count / total_neg * 100\n",
        "    # Dissatisfaction ratio: how much MORE likely is this aspect in negative vs all reviews\n",
        "    ratio = pct_neg / pct_all if pct_all > 0 else 0\n",
