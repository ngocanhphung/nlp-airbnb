        "        '% of All Reviews': round(pct_all, 1),\n",
        "        '% of Negative Reviews': round(pct_neg, 1),\n",
        "        'Dissatisfaction Ratio': round(ratio, 2)\n",
        "    })\n",
        "\n",
        "aspect_df = pd.DataFrame(aspect_stats).sort_values('% of Negative Reviews', ascending=False)\n",
        "print(aspect_df.to_string(index=False))"
