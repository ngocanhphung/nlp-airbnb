        "aspect_keywords = {\n",
        "    'Cleanliness':         ['clean', 'dirty', 'dust', 'stain', 'smell', 'smelly',\n",
        "                            'filthy', 'mold', 'mould', 'grubby', 'hygiene', 'tidy'],\n",
