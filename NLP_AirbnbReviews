      "source": [
        "## Question A - Lexicon-Based Sentiment Analysis (VADER)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "frNvPLb_4tZE"
      },
      "source": [
        "Among the 10 most popular Airbnb neighbourhoods in Victoria, which neighbourhoods show the highest and lowest levels of overall guest satisfaction based on review sentiment?"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "-PtF5ofA4szn",
        "outputId": "9d5779e4-6d14-4fa1-ef05-e1988385b0e9"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "  neighbourhood  total_reviews\n",
            "0     Melbourne         384863\n",
            "1  Port Phillip          90200\n",
            "2  Yarra Ranges          89863\n",
            "3         Yarra          79386\n",
            "4   Stonnington          43291\n",
            "5      Moreland          28182\n",
            "6   Maribyrnong          20333\n",
            "7       Darebin          16118\n",
            "8    Boroondara          14384\n",
            "9        Monash          13907\n"
          ]
        }
      ],
      "source": [
        "# \"Most popular\" = neighbourhood with highest total number of reviews across all its properties\n",
        "neighbourhood_popularity = (\n",
        "    listings.groupby('neighbourhood')['number_of_reviews']\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        "    .reset_index()\n",
        "    .rename(columns={'number_of_reviews': 'total_reviews'})\n",
        ")\n",
        "\n",
        "top10_neighbourhoods = neighbourhood_popularity.head(10)\n",
        "print(top10_neighbourhoods)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "TnDCXeuO5Tr3",
        "outputId": "54b5c335-7267-4331-d2c6-c25a6842183e"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Properties in top 10 neighbourhoods: 18100\n"
          ]
        }
      ],
      "source": [
        "# Filter listings to only those in the top 10 neighbourhoods\n",
        "top10_names = top10_neighbourhoods['neighbourhood'].tolist()\n",
        "top10_listings = listings[listings['neighbourhood'].isin(top10_names)][['id', 'neighbourhood']]\n",
        "\n",
        "print(f\"Properties in top 10 neighbourhoods: {len(top10_listings)}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "VE-BeU-m5x8V",
        "outputId": "64900da5-bbbc-43e4-e173-e8fa4ca3c678"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Reviews matched to top 10 neighbourhoods: 52667\n",
            "   listing_id neighbourhood                                           comments\n",
            "0     10803.0      Moreland  Perfect isnt enough! Lindsay was the best host...\n",
            "1     10803.0      Moreland  Conveniently located near the tram stop. \\r<br...\n",
            "2     10803.0      Moreland  Lindsay was a fantastic host. \\r<br/>The room ...\n"
          ]
        }
      ],
      "source": [
        "# Drop null comments first\n",
        "reviews_clean = reviews.dropna(subset=['comments']).copy()\n",
        "\n",
        "# Merge reviews with listing neighbourhood info\n",
        "reviews_merged = reviews_clean.merge(\n",
        "    top10_listings,\n",
        "    left_on='listing_id',\n",
        "    right_on='id',\n",
        "    how='inner'\n",
        ")\n",
        "\n",
        "print(f\"Reviews matched to top 10 neighbourhoods: {len(reviews_merged)}\")\n",
        "print(reviews_merged[['listing_id', 'neighbourhood', 'comments']].head(3))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "MBFXWw7p6hbW",
        "outputId": "713c220f-7955-4a2d-e155-3ae9a55e25d5"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "  neighbourhood  compound_score sentiment_label\n",
            "0      Moreland          0.9866        Positive\n",
            "1      Moreland          0.8176        Positive\n",
            "2      Moreland          0.9596        Positive\n",
            "3      Moreland          0.7783        Positive\n",
            "4      Moreland          0.6249        Positive\n",
            "\n",
            "Sentiment distribution:\n",
            " sentiment_label\n",
            "Positive    49696\n",
            "Neutral      2170\n",
            "Negative      801\n",
            "Name: count, dtype: int64\n"
          ]
        }
      ],
      "source": [
        "analyzer = SentimentIntensityAnalyzer()\n",
        "\n",
        "# Apply VADER to each comment — extract the compound score\n",
        "reviews_merged['compound_score'] = reviews_merged['comments'].apply(\n",
        "    lambda text: analyzer.polarity_scores(str(text))['compound']\n",
        ")\n",
        "\n",
        "# Classify sentiment for reference\n",
        "def classify_sentiment(score):\n",
        "    if score >= 0.05:\n",
        "        return 'Positive'\n",
        "    elif score <= -0.05:\n",
        "        return 'Negative'\n",
        "    else:\n",
        "        return 'Neutral'\n",
        "\n",
        "reviews_merged['sentiment_label'] = reviews_merged['compound_score'].apply(classify_sentiment)\n",
        "\n",
        "print(reviews_merged[['neighbourhood', 'compound_score', 'sentiment_label']].head())\n",
        "print(\"\\nSentiment distribution:\\n\", reviews_merged['sentiment_label'].value_counts())"
      ]
    },
